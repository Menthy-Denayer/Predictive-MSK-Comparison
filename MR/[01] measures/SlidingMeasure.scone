# Measure for toe clearance (penalize product vertical GRF & horizontal foot velocity)
ScriptMeasure {
	name = Clearance
	script_file = "[01] measures/scripts/SlidingMeasureScript.lua"
	weight = 1e-3 # auto added, don't need to define in script!
	velocity_threshold = 1.5
	com_height_threshold = 0.05
}