# Measure for mimicking 2D gait
MimicMeasure {
	name = Mimic
	weight = 250 # changed from 10000
	file = "[01] measures/data/Denayer2025-weightedWalking1kg.sto"
	#include_states = "*.activation;pelvis_tilt;pelvis_tx;pelvis_ty;ankle_angle_r;hip_flexion_r;knee_angle_r;ankle_angle_l;knee_angle_l;hip_flexion_l"
	#include_states = "*.activation"	
	#exclude_states = *;
	time_offset = 0 # stable time in Geyer & Herr solution
	#include_states = "*value"
	#stop_time = 10
	#threshold = 0.01 # threshold below which the error becomes zero
	#average_error_limit = 10 # above this error, the simulation is ended early
	#activation_error_weight = 0.25 # weight applied to the activation measure
}