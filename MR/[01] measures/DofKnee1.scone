CompositeMeasure {
	name = DofLimits
	signature = K1
	symmetric = 1
	DofMeasure {
		weight = 0.1
		dof = ankle_angle
		position { min = -60 max = 60 squared_penalty = 1 }
	}
	DofMeasure {
		weight = 0.02
		threshold = 1
		threshold_transition = 0.5
		dof = knee_angle
		limit_torque { min = 0 max = 0 abs_penalty = 1 }
	}
	DofMeasure {
		dof = pelvis_tilt
		weight = 0.01
		position { min = -45 max = 0 abs_penalty = 10 } # Penalize leaning backwards
		velocity { min = -10 max = 10 abs_penalty = 10 } # Penalize upper body motion
	}
}
